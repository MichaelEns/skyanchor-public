+/** Shared by union/catch contexts, so speculative and async work cannot reset limits. */
+export interface ParseBudget {
+  nodes: number;
+  slots: number;
+  issues: number;
+  depth: number;
+  exceeded: boolean;
+  rootIssues: ZodIssue[];
+}
+
+export const SKYANCHOR_PARSE_LIMITS = Object.freeze({
+  nodes: 16384,
+  slots: 32768,
+  issues: 128,
+  depth: 64,
+  collection: 4096,
+});
+
+export function exhaustParseBudget(ctx: ParseContext): void {
+  const budget = ctx.common.budget;
+  if (!budget || budget.exceeded) return;
+  budget.exceeded = true;
+  budget.rootIssues.push({
+    code: "custom",
+    path: [],
+    message: "Validation resource limit exceeded",
+  });
+}
+
+/** Reserve schema-driven fanout before constructing child pairs, contexts or promises. */
+export function reserveParseSlots(ctx: ParseContext, slots: number): boolean {
+  const budget = ctx.common.budget;
+  if (!budget || budget.exceeded) return false;
+  if (
+    slots > SKYANCHOR_PARSE_LIMITS.collection ||
+    budget.slots + slots > SKYANCHOR_PARSE_LIMITS.slots
+  ) {
+    exhaustParseBudget(ctx);
+    return false;
+  }
+  budget.slots += slots;
+  return true;
+}
+
+export function enterParse(input: ParseInput): ParseBudget | undefined {
+  const ctx = input.parent;
+  const budget = ctx.common.budget ?? (ctx.common.budget = {
+    nodes: 0, slots: 0, issues: 0, depth: 0,
+    exceeded: false, rootIssues: ctx.common.issues,
+  });
+  if (budget.exceeded) return;
+  let slots = 0;
+  const data: unknown = input.data;
+  if (Array.isArray(data)) slots = data.length;
+  else if (typeof Map !== "undefined" && data instanceof Map) slots = data.size * 2;
+  else if (typeof Set !== "undefined" && data instanceof Set) slots = data.size;
+  else if (data !== null && typeof data === "object") {
+    for (const _key in data) {
+      if (++slots > SKYANCHOR_PARSE_LIMITS.collection) break;
+    }
+  }
+  if (
+    ++budget.nodes > SKYANCHOR_PARSE_LIMITS.nodes ||
+    budget.depth >= SKYANCHOR_PARSE_LIMITS.depth ||
+    input.path.length > SKYANCHOR_PARSE_LIMITS.depth ||
+    slots > SKYANCHOR_PARSE_LIMITS.collection ||
+    (budget.slots += slots) > SKYANCHOR_PARSE_LIMITS.slots
+  ) {
+    exhaustParseBudget(ctx);
+    return;
+  }
+  budget.depth++;
+  return budget;
+}
